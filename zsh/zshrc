# ── GUI-style text selection on the command line ──────────────────────────────
# Hold Shift + arrows to highlight text, then Backspace/Delete removes the whole
# highlighted chunk at once (instead of one character at a time). Plain arrows
# clear the highlight. (Quick alternatives that always work: Ctrl-W delete word,
# Ctrl-U delete to line start, Ctrl-K delete to line end.)

# Extend the selection (starting it if needed), then run the movement widget.
_sel_extend() { (( REGION_ACTIVE )) || zle set-mark-command; zle "$1" }
# Clear any selection, then run the movement widget.
_sel_clear()  { (( REGION_ACTIVE )) && REGION_ACTIVE=0; zle "$1" }

sel-left()   { _sel_extend backward-char };     zle -N sel-left
sel-right()  { _sel_extend forward-char };      zle -N sel-right
sel-wleft()  { _sel_extend backward-word };     zle -N sel-wleft
sel-wright() { _sel_extend forward-word };      zle -N sel-wright
sel-home()   { _sel_extend beginning-of-line }; zle -N sel-home
sel-end()    { _sel_extend end-of-line };       zle -N sel-end
mov-left()   { _sel_clear backward-char };       zle -N mov-left
mov-home()   { _sel_clear beginning-of-line };   zle -N mov-home

# Delete the whole selection if active, else delete a single char as usual.
del-back-sel() { (( REGION_ACTIVE )) && { zle kill-region; return }; zle backward-delete-char }
del-fwd-sel()  { (( REGION_ACTIVE )) && { zle kill-region; return }; zle delete-char }
zle -N del-back-sel; zle -N del-fwd-sel

# After a paste, keep the pasted text selected (a real region) so Backspace or
# Delete removes the whole chunk at once when the paste turns out wrong.
paste-and-select() {
  local __start=$CURSOR
  zle .bracketed-paste
  MARK=$__start
  REGION_ACTIVE=1
}
zle -N bracketed-paste paste-and-select

# Shift + movement = extend the selection (these sequences are otherwise unused).
bindkey '^[[1;2D' sel-left    # Shift+Left
bindkey '^[[1;2C' sel-right   # Shift+Right
bindkey '^[[1;6D' sel-wleft   # Ctrl+Shift+Left  (word)
bindkey '^[[1;6C' sel-wright  # Ctrl+Shift+Right (word)
bindkey '^[[1;2H' sel-home    # Shift+Home
bindkey '^[[1;2F' sel-end     # Shift+End
# Left/Home clear the selection (Right/End are left alone so zsh-autosuggestions
# keeps accepting suggestions with the right arrow / End).
bindkey '^[[D' mov-left  ; bindkey '^[OD' mov-left
bindkey '^[[H' mov-home  ; bindkey '^[OH' mov-home
# Backspace / Delete remove the selection when there is one.
bindkey '^?' del-back-sel ; bindkey '^H' del-back-sel   # Backspace
bindkey '^[[3~' del-fwd-sel                              # Delete
