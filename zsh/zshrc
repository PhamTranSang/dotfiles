# ── Auto-start tmux ───────────────────────────────────────────────────────────
# Launch tmux automatically for interactive terminals. Guards skip it when:
#   - already inside tmux ($TMUX)          -> avoids nesting
#   - the shell isn't interactive          -> scp/rsync/scripts stay clean
#   - inside an editor terminal (VS Code)  -> those manage their own shell
# `exec tmux` gives each terminal its own session. For one shared session across
# all terminals instead, swap it for: exec tmux new-session -A -s main
if command -v tmux >/dev/null 2>&1 \
   && [[ $- == *i* ]] && [[ -z "$TMUX" ]] \
   && [[ "$TERM_PROGRAM" != "vscode" && -z "$VSCODE_INJECTION" ]] \
   && [[ -z "$INSIDE_EMACS" ]]; then
  exec tmux
fi

